# Supabase client config. The anon key is a PUBLIC key by design (RLS enforces
# access control) and is safe to inline into the browser bundle.
#
# The VITE_ prefix is mandatory: only VITE_-prefixed vars are inlined into
# client JS by Vite. Do NOT reuse these names for the server-only
# api/debt-view.ts function (that uses unprefixed SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY -- see design.md D2/research C12).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
